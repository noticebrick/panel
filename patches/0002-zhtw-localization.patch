 namespace Pterodactyl\Http\Requests\Base;
 
+use Illuminate\Validation\Rule;
 use Illuminate\Foundation\Http\FormRequest;
+use Pterodactyl\Traits\Helpers\AvailableLanguages;
 
 class LocaleRequest extends FormRequest
 {
+    use AvailableLanguages;
+
     public function rules(): array
     {
         return [
-            'locale' => ['required', 'string', 'regex:/^[a-z][a-z]$/'],
+            'locale' => ['required', 'string', Rule::in(array_keys($this->getAvailableLanguages()))],
             'namespace' => ['required', 'string', 'regex:/^[a-z]{1,191}$/'],
         ];
     }
diff --git a/app/Traits/Helpers/AvailableLanguages.php b/app/Traits/Helpers/AvailableLanguages.php
index d487e8ecc..be53917ab 100644
--- a/app/Traits/Helpers/AvailableLanguages.php
+++ b/app/Traits/Helpers/AvailableLanguages.php
@@ -3,6 +3,7 @@
 namespace Pterodactyl\Traits\Helpers;
 
 use Matriphe\ISO639\ISO639;
+use Illuminate\Support\Str;
 use Illuminate\Filesystem\Filesystem;
 
 trait AvailableLanguages
@@ -19,12 +20,27 @@ trait AvailableLanguages
     {
         return collect($this->getFilesystemInstance()->directories(resource_path('lang')))->mapWithKeys(function ($path) use ($localize) {
             $code = basename($path);
-            $value = $localize ? $this->getIsoInstance()->nativeByCode1($code) : $this->getIsoInstance()->languageByCode1($code);
+            $regionalKey = str_replace('-', '_', $code);
+            $regionalName = $this->regionalLanguageName($regionalKey, $localize);
+            if (!is_null($regionalName)) {
+                return [$code => $regionalName];
+            }
 
-            return [$code => title_case($value)];
+            $lookup = Str::lower(explode('_', $regionalKey, 2)[0]);
+            $value = $localize ? $this->getIsoInstance()->nativeByCode1($lookup) : $this->getIsoInstance()->languageByCode1($lookup);
+
+            return [$code => Str::title((string) ($value ?: $code))];
         })->toArray();
     }
 
+    private function regionalLanguageName(string $code, bool $localize): ?string
+    {
+        return match ($code) {
+            'zh_TW' => $localize ? '繁體中文（台灣）' : 'Chinese (Traditional, Taiwan)',
+            default => null,
+        };
+    }
+
     /**
      * Return an instance of the filesystem for getting a folder listing.
      */
