@@ -9,8 +9,21 @@ class LocaleRequest extends FormRequest
     public function rules(): array
     {
         return [
-            'locale' => ['required', 'string', 'regex:/^[a-z][a-z]$/'],
-            'namespace' => ['required', 'string', 'regex:/^[a-z]{1,191}$/'],
+            // Accept single or batched locales, e.g. "zh" or "zh+en".
+            'locale' => [
+                'required',
+                'string',
+                'max:512',
+                'regex:/^[a-z]{2}(?:[_-][A-Za-z]{2})?(?:[,+\s][a-z]{2}(?:[_-][A-Za-z]{2})?)*$/',
+            ],
+            // Accept single or batched namespaces, e.g. "dashboard/index" or
+            // "dashboard/index+strings+server/console_ui".
+            'namespace' => [
+                'required',
+                'string',
+                'max:1024',
+                'regex:/^[a-z0-9_\/-]+(?:[,+\s][a-z0-9_\/-]+)*$/',
+            ],
         ];
     }
 }
diff --git a/app/Traits/Helpers/AvailableLanguages.php b/app/Traits/Helpers/AvailableLanguages.php
index d487e8ecc..25b4e9c5d 100644
--- a/app/Traits/Helpers/AvailableLanguages.php
+++ b/app/Traits/Helpers/AvailableLanguages.php
@@ -17,12 +17,39 @@ trait AvailableLanguages
      */
     public function getAvailableLanguages(bool $localize = false): array
     {
-        return collect($this->getFilesystemInstance()->directories(resource_path('lang')))->mapWithKeys(function ($path) use ($localize) {
-            $code = basename($path);
-            $value = $localize ? $this->getIsoInstance()->nativeByCode1($code) : $this->getIsoInstance()->languageByCode1($code);
+        $availableCodes = collect($this->getFilesystemInstance()->directories(resource_path('lang')))
+            ->map(fn (string $path) => basename($path))
+            ->values();
+
+        return $availableCodes->mapWithKeys(function ($code) use ($localize, $availableCodes) {
+            // If the base language exists, hide regional variants (e.g. zh_TW)
+            // so users only see one language choice ("zh").
+            if (preg_match('/^([a-z]{2})[_-][A-Za-z]{2}$/', $code, $matches) && $availableCodes->contains(strtolower($matches[1]))) {
+                return [];
+            }
+
+            $path = resource_path('lang/' . $code);
+            // Skip empty locale directories to avoid exposing broken options.
+            if (count($this->getFilesystemInstance()->allFiles($path)) === 0) {
+                return [];
+            }
+
+            preg_match('/^[a-z]{2}/i', $code, $matches);
+            $baseCode = strtolower($matches[0] ?? $code);
+
+            $value = $localize ? $this->getIsoInstance()->nativeByCode1($baseCode) : $this->getIsoInstance()->languageByCode1($baseCode);
+            if (!is_string($value) || $value === '') {
+                $value = $code;
+            }
+
+            // If a regional locale exists (e.g. zh_TW), keep the region visible
+            // so admins can distinguish it from its base language option.
+            if ($baseCode !== strtolower($code)) {
+                $value = sprintf('%s (%s)', $value, str_replace('_', '-', $code));
+            }
 
             return [$code => title_case($value)];
-        })->toArray();
+        })->sortKeys()->toArray();
     }
 
     /**
