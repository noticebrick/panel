diff --git a/app/Traits/Helpers/NormalizesLocales.php b/app/Traits/Helpers/NormalizesLocales.php
new file mode 100644
index 000000000..a7aab20a6
--- /dev/null
+++ b/app/Traits/Helpers/NormalizesLocales.php
@@ -0,0 +1,45 @@
+<?php
+
+namespace Pterodactyl\Traits\Helpers;
+
+trait NormalizesLocales
+{
+    /**
+     * Convert common locale aliases into the directory names used by Laravel.
+     */
+    protected function normalizeLocaleCode(?string $locale, string $fallback = 'en'): string
+    {
+        $value = trim((string) $locale);
+        if ($value === '') {
+            return $fallback;
+        }
+
+        $normalized = str_replace('-', '_', $value);
+        $lowered = mb_strtolower($normalized);
+
+        if (in_array($lowered, ['zhtw', 'zh_tw'], true)) {
+            return 'zh_TW';
+        }
+
+        if (str_contains($normalized, '_')) {
+            [$language, $region] = explode('_', $normalized, 2);
+
+            return mb_strtolower($language) . '_' . mb_strtoupper($region);
+        }
+
+        return $lowered;
+    }
+
+    /**
+     * Normalize the language and namespace lists sent by i18next's multiload backend.
+     */
+    protected function normalizeLocaleList(string $locales, string $fallback = 'en'): array
+    {
+        return collect(preg_split('/[+ ]+/', $locales) ?: [])
+            ->map(fn ($locale) => $this->normalizeLocaleCode($locale, $fallback))
+            ->filter()
+            ->unique()
+            ->values()
+            ->toArray();
+    }
+}
