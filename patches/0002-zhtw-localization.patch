diff --git a/resources/scripts/components/dashboard/forms/UpdateLanguageForm.tsx b/resources/scripts/components/dashboard/forms/UpdateLanguageForm.tsx
new file mode 100644
index 000000000..1e7bd68e3
--- /dev/null
+++ b/resources/scripts/components/dashboard/forms/UpdateLanguageForm.tsx
@@ -0,0 +1,116 @@
+import React, { useEffect, useState } from 'react';
+import SpinnerOverlay from '@/components/elements/SpinnerOverlay';
+import Label from '@/components/elements/Label';
+import Select from '@/components/elements/Select';
+import tw from 'twin.macro';
+import { Button } from '@/components/elements/button/index';
+import { useTranslation } from 'react-i18next';
+import { Actions, State, useStoreActions, useStoreState } from 'easy-peasy';
+import { ApplicationStore } from '@/state';
+import getAvailableLanguages, { AccountLanguage } from '@/api/account/getAvailableLanguages';
+import { httpErrorToHuman } from '@/api/http';
+import i18n from '@/i18n';
+
+export default () => {
+    const { t } = useTranslation('dashboard/account');
+    const user = useStoreState((state: State<ApplicationStore>) => state.user.data);
+    const updateLanguage = useStoreActions((state: Actions<ApplicationStore>) => state.user.updateUserLanguage);
+    const { clearFlashes, addFlash } = useStoreActions((actions: Actions<ApplicationStore>) => actions.flashes);
+
+    const [languages, setLanguages] = useState<AccountLanguage[]>([]);
+    const [language, setLanguage] = useState(user?.language || 'en');
+    const [submitting, setSubmitting] = useState(false);
+    const [loadingLanguages, setLoadingLanguages] = useState(true);
+
+    useEffect(() => {
+        if (user?.language) {
+            setLanguage(user.language);
+        }
+    }, [user?.language]);
+
+    useEffect(() => {
+        getAvailableLanguages()
+            .then((data) => setLanguages(data))
+            .catch((error) =>
+                addFlash({
+                    key: 'account:language',
+                    type: 'error',
+                    title: t('error_title'),
+                    message: httpErrorToHuman(error),
+                })
+            )
+            .then(() => setLoadingLanguages(false));
+    }, []);
+
+    if (!user) {
+        return null;
+    }
+
+    const submit = () => {
+        clearFlashes('account:language');
+        setSubmitting(true);
+
+        updateLanguage(language)
+            .then(() => {
+                (window as Window & { PterodactylUser?: { language?: string } }).PterodactylUser &&
+                    ((window as Window & { PterodactylUser?: { language?: string } }).PterodactylUser!.language =
+                        language);
+                i18n.changeLanguage(language);
+
+                addFlash({
+                    type: 'success',
+                    key: 'account:language',
+                    message: t('language.updated'),
+                });
+            })
+            .catch((error) =>
+                addFlash({
+                    key: 'account:language',
+                    type: 'error',
+                    title: t('error_title'),
+                    message: httpErrorToHuman(error),
+                })
+            )
+            .then(() => setSubmitting(false));
+    };
+
+    return (
+        <div css={tw`relative`}>
+            <SpinnerOverlay size={'large'} visible={submitting} />
+            <Label htmlFor={'account_language'}>{t('language.label')}</Label>
+            <Select
+                id={'account_language'}
+                value={language}
+                disabled={loadingLanguages || !languages.length}
+                onChange={(e) => setLanguage(e.currentTarget.value)}
+            >
+                {languages.map((item) => (
+                    <option key={item.code} value={item.code}>
+                        {item.name}
+                    </option>
+                ))}
+            </Select>
+            <p className={'input-help'}>
+                {loadingLanguages
+                    ? t('language.loading')
+                    : languages.length
+                    ? t('language.help')
+                    : t('language.none_available')}
+            </p>
+            <div css={tw`mt-6`}>
+                <Button
+                    type={'button'}
+                    disabled={
+                        submitting ||
+                        loadingLanguages ||
+                        !languages.length ||
+                        language === user.language
+                    }
+                    onClick={submit}
+                >
+                    {t('language.update_button')}
+                </Button>
+            </div>
+        </div>
+    );
+};
