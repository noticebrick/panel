diff --git a/resources/scripts/lib/domLiterals.ts b/resources/scripts/lib/domLiterals.ts
new file mode 100644
index 000000000..125dbe93f
--- /dev/null
+++ b/resources/scripts/lib/domLiterals.ts
@@ -0,0 +1,138 @@
+import i18n from '@/i18n';
+import { translateLiteral } from '@/lib/literals';
+
+const SKIPPED_TAGS = new Set(['SCRIPT', 'STYLE', 'NOSCRIPT', 'TEXTAREA', 'PRE', 'CODE']);
+const TRANSFORMED_ATTRIBUTES = ['title', 'placeholder', 'aria-label', 'data-original-title', 'value'] as const;
+
+const trimAndNormalize = (value: string): string => value.replace(/\u00a0/g, ' ').trim();
+
+const shouldTranslateElementValue = (element: Element): boolean => {
+    if (element.tagName === 'INPUT') {
+        const input = element as HTMLInputElement;
+        return ['button', 'submit', 'reset'].includes(input.type);
+    }
+
+    return element.tagName === 'BUTTON';
+};
+
+const translateValue = (value: string): string => {
+    const normalized = trimAndNormalize(value);
+    if (normalized.length === 0) {
+        return value;
+    }
+
+    const translated = translateLiteral(normalized, i18n.t.bind(i18n));
+    if (translated === normalized) {
+        return value;
+    }
+
+    const leading = value.match(/^\s*/u)?.[0] ?? '';
+    const trailing = value.match(/\s*$/u)?.[0] ?? '';
+
+    return `${leading}${translated}${trailing}`;
+};
+
+const translateTextNode = (node: Text): void => {
+    const parent = node.parentElement;
+    if (!parent || SKIPPED_TAGS.has(parent.tagName) || parent.closest('[data-no-localize]')) {
+        return;
+    }
+
+    const value = node.nodeValue || '';
+    const translated = translateValue(value);
+    if (translated !== value) {
+        node.nodeValue = translated;
+    }
+};
+
+const translateElementAttributes = (element: Element): void => {
+    if (element.closest('[data-no-localize]')) {
+        return;
+    }
+
+    TRANSFORMED_ATTRIBUTES.forEach((attribute) => {
+        if (!element.hasAttribute(attribute)) {
+            return;
+        }
+
+        if (attribute === 'value' && !shouldTranslateElementValue(element)) {
+            return;
+        }
+
+        const value = element.getAttribute(attribute);
+        if (!value) {
+            return;
+        }
+
+        const translated = translateValue(value);
+        if (translated !== value) {
+            element.setAttribute(attribute, translated);
+        }
+    });
+};
+
+const translateTree = (root: ParentNode): void => {
+    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
+    let current = walker.nextNode();
+    while (current) {
+        translateTextNode(current as Text);
+        current = walker.nextNode();
+    }
+
+    if (root instanceof Element) {
+        translateElementAttributes(root);
+    }
+
+    const elements = (root as Element | Document).querySelectorAll
+        ? (root as Element | Document).querySelectorAll('*')
+        : [];
+
+    elements.forEach((element) => translateElementAttributes(element));
+};
+
+export const setupDomLiteralLocalization = (): (() => void) => {
+    if (typeof window === 'undefined' || typeof document === 'undefined') {
+        return () => undefined;
+    }
+
+    const run = () => translateTree(document.body);
+    run();
+
+    const observer = new MutationObserver((mutations) => {
+        mutations.forEach((mutation) => {
+            if (mutation.type === 'characterData' && mutation.target.nodeType === Node.TEXT_NODE) {
+                translateTextNode(mutation.target as Text);
+                return;
+            }
+
+            if (mutation.type === 'attributes' && mutation.target instanceof Element) {
+                translateElementAttributes(mutation.target);
+                return;
+            }
+
+            mutation.addedNodes.forEach((node) => {
+                if (node.nodeType === Node.TEXT_NODE) {
+                    translateTextNode(node as Text);
+                } else if (node.nodeType === Node.ELEMENT_NODE) {
+                    translateTree(node as Element);
+                }
+            });
+        });
+    });
+
+    observer.observe(document.body, {
+        childList: true,
+        subtree: true,
+        characterData: true,
+        attributes: true,
+        attributeFilter: [...TRANSFORMED_ATTRIBUTES],
+    });
+
+    const onLanguageChanged = () => run();
+    i18n.on('languageChanged', onLanguageChanged);
+
+    return () => {
+        observer.disconnect();
+        i18n.off('languageChanged', onLanguageChanged);
+    };
+};
diff --git a/resources/scripts/lib/literals.ts b/resources/scripts/lib/literals.ts
new file mode 100644
index 000000000..55b857fd8
--- /dev/null
+++ b/resources/scripts/lib/literals.ts
@@ -0,0 +1,33 @@
+import React from 'react';
+import { TFunction } from 'i18next';
+
+const translationOptions = {
+    ns: 'literals',
+    keySeparator: false,
+    nsSeparator: false,
+};
+
+const toInterpolationString = (value: string): string =>
+    value.replace(/:([\w.-]+\w)([^\w:]?|$)/gm, '{{$1}}$2');
+
+export const translateLiteral = (
+    value: string,
+    t: TFunction,
+    values?: Record<string, unknown>
+): string =>
+    (t as any)(value, {
+        ...translationOptions,
+        defaultValue: toInterpolationString(value),
+        ...(values || {}),
+    });
+
+export const translateLiteralNode = (value: React.ReactNode, t: TFunction): React.ReactNode => {
+    if (typeof value === 'string') {
+        return translateLiteral(value, t);
+    }
+
+    return Array.isArray(value) ? value.map((item) => translateLiteralNode(item, t)) : value;
+};
+
+export const translateLiteralValue = <TValue>(value: TValue, t: TFunction): TValue =>
+    typeof value === 'string' ? (translateLiteral(value, t) as TValue) : value;
diff --git a/resources/scripts/lib/locale.ts b/resources/scripts/lib/locale.ts
new file mode 100644
index 000000000..781e82a27
--- /dev/null
+++ b/resources/scripts/lib/locale.ts
@@ -0,0 +1,22 @@
+export const normalizeLocale = (value?: string): string => {
+    if (!value) {
+        return 'en';
+    }
+
+    const normalized = value.trim().replace('-', '_');
+    const lowered = normalized.toLowerCase();
+
+    if (['zhtw', 'zh_tw'].includes(lowered)) {
+        return 'zh_TW';
+    }
+
+    const [language, region] = normalized.split('_');
+
+    return region ? `${language.toLowerCase()}_${region.toUpperCase()}` : language.toLowerCase();
+};
+
+export const encodeLocaleList = (values: readonly string[]): string =>
+    values.map((value) => encodeURIComponent(normalizeLocale(value))).join('%2B');
+
+export const encodeNamespaceList = (values: readonly string[]): string =>
+    values.map((value) => encodeURIComponent(value)).join('%2B');
