+import http from '@/api/http';
+
+export interface AccountLanguage {
+    code: string;
+    name: string;
+}
+
+export default (): Promise<AccountLanguage[]> => {
+    return new Promise((resolve, reject) => {
+        http.get('/api/client/account/languages')
+            .then(({ data }) => resolve(data.data || []))
+            .catch(reject);
+    });
+};
