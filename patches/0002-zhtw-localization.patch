@@ -4,9 +4,18 @@ namespace Pterodactyl\Http\ViewComposers;
 
 use Illuminate\View\View;
 use Pterodactyl\Services\Helpers\AssetHashService;
+use Pterodactyl\Traits\Helpers\AvailableLanguages;
+use Symfony\Component\Finder\SplFileInfo;
 
 class AssetComposer
 {
+    use AvailableLanguages;
+
+    /**
+     * @var array<string, array<string, string>>
+     */
+    private array $literalMapCache = [];
+
     /**
      * AssetComposer constructor.
      */
@@ -19,14 +28,105 @@ class AssetComposer
      */
     public function compose(View $view): void
     {
+        $locale = $this->normalizeLocaleCode(app()->getLocale() ?? config('app.locale') ?? 'en');
+
         $view->with('asset', $this->assetHashService);
+        $view->with('literalMap', $this->buildLiteralMap($locale));
         $view->with('siteConfiguration', [
             'name' => config('app.name') ?? 'Pterodactyl',
-            'locale' => config('app.locale') ?? 'en',
+            'locale' => $this->normalizeLocaleCode(config('app.locale') ?? 'en'),
+            'languages' => $this->getAvailableLanguages(true),
             'recaptcha' => [
                 'enabled' => config('recaptcha.enabled', false),
                 'siteKey' => config('recaptcha.website_key') ?? '',
             ],
         ]);
     }
+
+    /**
+     * Build a literal replacement map where English text is the key and localized text is the value.
+     * This lets legacy Blade templates localize plain hardcoded text without per-view refactors.
+     */
+    private function buildLiteralMap(string $locale): array
+    {
+        if (isset($this->literalMapCache[$locale])) {
+            return $this->literalMapCache[$locale];
+        }
+
+        $map = [];
+        $enRoot = resource_path('lang/en');
+        $localeRoot = resource_path("lang/{$locale}");
+
+        foreach ($this->getFilesystemInstance()->allFiles($enRoot) as $file) {
+            /** @var SplFileInfo $file */
+            if ($file->getExtension() !== 'php') {
+                continue;
+            }
+
+            $enPath = $file->getRealPath();
+            if ($enPath === false) {
+                continue;
+            }
+
+            $relative = ltrim(str_replace($enRoot, '', $enPath), DIRECTORY_SEPARATOR);
+            $localePath = $localeRoot . DIRECTORY_SEPARATOR . $relative;
+
+            if (!is_file($localePath)) {
+                continue;
+            }
+
+            /** @var array<string, mixed> $enLines */
+            $enLines = include $enPath;
+            /** @var array<string, mixed> $localizedLines */
+            $localizedLines = include $localePath;
+
+            if (!is_array($enLines) || !is_array($localizedLines)) {
+                continue;
+            }
+
+            $flatEn = $this->flattenTranslationLines($enLines);
+            $flatLocalized = $this->flattenTranslationLines($localizedLines);
+
+            foreach ($flatEn as $key => $english) {
+                $localized = $flatLocalized[$key] ?? null;
+                if (!is_string($english) || !is_string($localized)) {
+                    continue;
+                }
+
+                if (trim($english) === '' || !preg_match('/[A-Za-z]/', $english)) {
+                    continue;
+                }
+
+                if (!array_key_exists($english, $map) || $map[$english] === $english) {
+                    $map[$english] = $localized;
+                }
+            }
+        }
+
+        return $this->literalMapCache[$locale] = $map;
+    }
+
+    /**
+     * @param array<string, mixed> $lines
+     * @return array<string, string>
+     */
+    private function flattenTranslationLines(array $lines, string $prefix = ''): array
+    {
+        $flat = [];
+
+        foreach ($lines as $key => $value) {
+            $segment = $prefix === '' ? (string) $key : "{$prefix}.{$key}";
+
+            if (is_array($value)) {
+                $flat += $this->flattenTranslationLines($value, $segment);
+                continue;
+            }
+
+            if (is_string($value)) {
+                $flat[$segment] = $value;
+            }
+        }
+
+        return $flat;
+    }
 }
