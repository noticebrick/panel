 use Illuminate\Foundation\Http\FormRequest;
+use Pterodactyl\Traits\Helpers\AvailableLanguages;
 
 class LocaleRequest extends FormRequest
 {
+    use AvailableLanguages;
+
     public function rules(): array
     {
         return [
-            'locale' => ['required', 'string', 'regex:/^[a-z][a-z]$/'],
-            'namespace' => ['required', 'string', 'regex:/^[a-z]{1,191}$/'],
+            'locale' => ['required', 'string', function (string $attribute, mixed $value, \Closure $fail) {
+                $languages = array_keys($this->getAvailableLanguages());
+                foreach ($this->normalizeLocaleList((string) $value) as $locale) {
+                    if (!in_array($locale, $languages, true)) {
+                        $fail('The selected locale is invalid.');
+                    }
+                }
+            }],
+            'namespace' => ['required', 'string', function (string $attribute, mixed $value, \Closure $fail) {
+                foreach (preg_split('/[+ ]+/', (string) $value) ?: [] as $namespace) {
+                    if (!preg_match('/^[a-z]{1,191}$/', $namespace)) {
+                        $fail('The selected namespace is invalid.');
+                    }
+                }
+            }],
         ];
     }
+
+    protected function prepareForValidation(): void
+    {
+        if ($this->has('locale')) {
+            $this->merge([
+                'locale' => implode('+', $this->normalizeLocaleList((string) $this->input('locale'))),
+            ]);
+        }
+    }
 }
